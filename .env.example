# Local development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./urls.db

# PostgreSQL (production / assessment)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/urlshort

# Rate limiting (slowapi)
SHORTEN_RATE_LIMIT=10/minute
REDIRECT_RATE_LIMIT=60/minute

# Storage for rate-limit counters.
# memory:// works per-process (single worker / dev).
# Use a shared store for multiple workers / instances:
# RATE_LIMIT_STORAGE=redis://localhost:6379
RATE_LIMIT_STORAGE=memory://